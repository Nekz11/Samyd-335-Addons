<Bindings>
	<Binding name="BETTERPLATES_FRIENDS" header="BETTERPLATES">
		BetterPlates_ToggleFriends()
	</Binding>
	<Binding name="BETTERPLATES_ENEMIES">
		BetterPlates_ToggleEnemies()
	</Binding>
	<Binding name="BETTERPLATES_STACKING">
		BetterPlates_ToggleStacking()
	</Binding>
	<Binding name="BETTERPLATES_OPTIONS">
		BetterPlates_Options()
	</Binding>
	<Binding name="BETTERPLATES_ALL">
		BetterPlates_ToggleAll()
	</Binding>
	<Binding name="BETTERPLATES_TEST">
		BetterPlates_Test()
	</Binding>
</Bindings>
